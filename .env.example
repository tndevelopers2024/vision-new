# =============================================================================
# Vision Business Setup — Environment Configuration Example
# =============================================================================
# Copy this file to .env and configure with your active credentials.
# NEVER commit .env to source control (.gitignore strictly enforces this).
# =============================================================================

# SMTP Server Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_SECURE: true for port 465 (SSL), false for port 587 (TLS/STARTTLS) or port 25
SMTP_SECURE=false
SMTP_USER=no-reply@visionbusinesssetup.ae
SMTP_PASS=your-smtp-password-or-app-key

# Mail Transmission Headers & Destination
# SMTP_FROM: Formatted "Sender Name <email@domain.com>" or "email@domain.com"
SMTP_FROM="Vision Business Setup" <no-reply@visionbusinesssetup.ae>
# CONTACT_RECIPIENT_EMAIL: Inbox where incoming client inquiries are delivered
CONTACT_RECIPIENT_EMAIL=admin@visionbusinesssetup.ae
